msgid "Username"
msgstr "Usuário"

msgid "Password"
msgstr "Senha"

msgid "Email"
msgstr "E-mail"

msgid "Subject"
msgstr "Assunto"

msgid "Message"
msgstr "Mensagem"

msgid "I agree that my email may be used only to reply to this message."
msgstr "Concordo que meu e-mail seja usado apenas para responder a esta mensagem."

msgid "Your email, subject and message are delivered through Resend only so 1415 Agri can reply; this site does not store them."
msgstr "Seu e-mail, assunto e mensagem são enviados pelo Resend apenas para que a 1415 Agri possa responder; este site não os armazena."

msgid "Enter a subject on one line."
msgstr "Digite o assunto em uma única linha."

msgid "Unable to submit this message."
msgstr "Não foi possível enviar esta mensagem."

msgid "We could not send your message right now. Please try again."
msgstr "Não foi possível enviar sua mensagem agora. Tente novamente."

msgid "Language"
msgstr "Idioma"

# Farmer interface (PR3A)
msgid "Satellite signals translated into practical field zones."
msgstr "Sinais de satélite traduzidos em zonas práticas da lavoura."

#, python-format
msgid "Map your field · %(product_name)s"
msgstr "Mapeie sua lavoura · %(product_name)s"

msgid "Please wait…"
msgstr "Aguarde…"

msgid "Something went wrong. Please try again."
msgstr "Algo deu errado. Tente novamente."

msgid "Your session expired. Sign in again."
msgstr "Sua sessão expirou. Entre novamente."

msgid "This action conflicts with the current state. Refresh and try again."
msgstr "Esta ação conflita com o estado atual. Atualize a página e tente novamente."

msgid "Check the highlighted information and try again."
msgstr "Confira as informações destacadas e tente novamente."

msgid "The daily analysis limit was reached. Try again tomorrow."
msgstr "O limite diário de análises foi atingido. Tente novamente amanhã."

msgid "Requesting your location…"
msgstr "Solicitando sua localização…"

msgid "Location captured. You can fine-tune the coordinates below."
msgstr "Localização capturada. Você pode ajustar as coordenadas abaixo."

msgid "Location was not shared. Enter the coordinates or use the demonstration property."
msgstr "A localização não foi compartilhada. Digite as coordenadas ou use a propriedade demonstrativa."

msgid "Demonstration property loaded."
msgstr "Propriedade demonstrativa carregada."

msgid "Saving the field and estimating its boundary…"
msgstr "Salvando a lavoura e estimando seu limite…"

msgid "Boundary estimate ready. Review every vertex before confirming."
msgstr "Estimativa do limite pronta. Revise cada ponto antes de confirmar."

msgid "Confirming the boundary…"
msgstr "Confirmando o limite…"

msgid "Sending the analysis to the processing queue…"
msgstr "Enviando a análise para a fila de processamento…"

msgid "The analysis is still processing. This page will update automatically."
msgstr "A análise ainda está sendo processada. Esta página será atualizada automaticamente."

msgid "The analysis could not be completed."
msgstr "Não foi possível concluir a análise."

msgid "Lower relative development"
msgstr "Desenvolvimento relativo menor"

msgid "Similar relative development"
msgstr "Desenvolvimento relativo semelhante"

msgid "Higher relative development"
msgstr "Desenvolvimento relativo maior"

msgid "Zone"
msgstr "Zona"

msgid "ha"
msgstr "ha"

msgid "Relative development zones within the confirmed field boundary"
msgstr "Zonas de desenvolvimento relativo dentro do limite confirmado da lavoura"

msgid "Precision agriculture, made accessible"
msgstr "Agricultura de precisão ao alcance de todos"

msgid "See differences the eye cannot see."
msgstr "Veja diferenças que os olhos não conseguem ver."

msgid "Mark your field, compare its spectral history and receive a clear map of areas that developed differently."
msgstr "Marque sua lavoura, compare seu histórico espectral e receba um mapa claro das áreas que se desenvolveram de forma diferente."

#, python-format
msgid "Connected as %(username)s"
msgstr "Conectado como %(username)s"

