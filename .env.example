# Runtime mode. Production enforces explicit secret key and allowed hosts.
APP_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
DJANGO_TIME_ZONE=America/Sao_Paulo

# Product and demonstration account. Keep the hash in single quotes because it contains `$`.
PRODUCT_NAME=Agentic Agriculture
DEMO_USERNAME=demo
DEMO_PASSWORD_HASH='replace-with-a-django-password-hash'

# PR2 data backends. Local/test mode is deterministic but process-local.
PERSISTENCE_BACKEND=memory
ARTIFACT_BACKEND=memory
TASK_BACKEND=memory
ANALYSIS_DAILY_LIMIT=3
API_MAX_REQUEST_BYTES=262144

# Required when the corresponding Google Cloud backend is selected.
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE=(default)
GCS_BUCKET=
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_QUEUE=
CLOUD_TASKS_BASE_URL=
CLOUD_TASKS_SERVICE_ACCOUNT=
# Generate at least 32 random characters; sent only in the internal task header.
CLOUD_TASKS_SHARED_SECRET=

# Public Sentinel-2 catalog and private MCP service. Earth Search needs no account or API key.
EARTH_SEARCH_URL=https://earth-search.aws.element84.com/v1
MCP_HOST=0.0.0.0
MCP_URL=http://geospatial-mcp:8090/mcp

# HTTP and cookie behavior.
PORT=8080
# Keep one worker with the process-local memory backend. Firestore production can scale out.
WEB_CONCURRENCY=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
DJANGO_SESSION_COOKIE_AGE=28800
DJANGO_COOKIE_SECURE=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
