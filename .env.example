# Runtime mode. Production enforces explicit secret key and allowed hosts.
APP_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
DJANGO_TIME_ZONE=America/Sao_Paulo
DJANGO_SETTINGS_MODULE=config.settings

# Product and demonstration account. Keep the hash in single quotes because it contains `$`.
PRODUCT_NAME=Agentic Agriculture
DEMO_USERNAME=demo
DEMO_PASSWORD_HASH='replace-with-a-django-password-hash'

# PR2 data backends. Local/test mode is deterministic but process-local.
PERSISTENCE_BACKEND=memory
ARTIFACT_BACKEND=memory
TASK_BACKEND=memory
BOUNDARY_BACKEND=fixture
ANALYSIS_PIPELINE_BACKEND=disabled
ANALYSIS_TARGET_SCENE_COUNT=6
ANALYSIS_MAX_DIMENSION=512
ANALYSIS_DAILY_LIMIT=3
API_MAX_REQUEST_BYTES=262144

# Required when the corresponding Google Cloud backend is selected.
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE=(default)
GCS_BUCKET=
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_QUEUE=
CLOUD_TASKS_BASE_URL=
# Required in production so Cloud Tasks can mint OIDC tokens for the private worker.
CLOUD_TASKS_SERVICE_ACCOUNT=
CLOUD_TASKS_DISPATCH_DEADLINE_SECONDS=900
# Generate at least 32 random characters; sent only in the internal task header.
CLOUD_TASKS_SHARED_SECRET=

# Private MCP service. The trusted Earth Search endpoint is fixed in code and needs no account.
MCP_HOST=0.0.0.0
MCP_URL=http://geospatial-mcp:8090/mcp

# Google ADK/Gemini agent. In Cloud Run, use Vertex AI through the service account.
AGENT_MODEL=gemini-3.5-flash
AGENT_APP_NAME=agentic_agriculture
AGENT_MCP_ENABLED=true
AGENT_MCP_URL=http://geospatial-mcp:8090/mcp
# Set both values to the private MCP Cloud Run service origin in production.
AGENT_MCP_AUDIENCE=
AGENT_MCP_TIMEOUT_SECONDS=15
AGENT_MCP_TOOL_CACHE_SECONDS=300
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_LOCATION=global

# HTTP and cookie behavior.
PORT=8080
# Keep one worker with the process-local memory backend. Firestore production can scale out.
WEB_CONCURRENCY=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=840
DJANGO_SESSION_COOKIE_AGE=28800
DJANGO_COOKIE_SECURE=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
