# Runtime mode. Production enforces explicit secret key and allowed hosts.
APP_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
DJANGO_TIME_ZONE=America/Sao_Paulo

# Product and demonstration account. Keep the hash in single quotes because it contains `$`.
PRODUCT_NAME=Agentic Agriculture
DEMO_USERNAME=demo
DEMO_PASSWORD_HASH='replace-with-a-django-password-hash'

# HTTP and cookie behavior.
PORT=8080
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
DJANGO_SESSION_COOKIE_AGE=28800
DJANGO_COOKIE_SECURE=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
